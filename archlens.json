{
    "name": "Archlens",
    "rootFolder": ".",
    "github": {
        "url": "https://github.com/archlens/ArchLens",
        "branch": "main"
    },
    "saveLocation": "./diagrams/",
    "runCommand": "go run ./ast_parsers/go/ast_parser.go",
    "views": {
        "completeView": {
            "include": [
                "**/*.go",
                "*.go"
            ],
            "exclude": [
                "go.sum",
                "go.mod", 
                ".dagger/*",
                "ast_parsers/go/*"
            ]
        },
        "smallerView": {
            "include": [
                "cmd/*.*",
                "main.go"
            ],
            "exclude": []
        }
    }
}
