{
    "name": "Archlens",
    "rootFolder": ".",
    "github": {
        "url": "https://github.com/archlens/ArchLens",
        "branch": "main"
    },
    "saveLocation": "diagrams/",
    "runCommand": "go run ast_parsers/go/ast_parser.go",
    "files": ["*.go"],
    "views": {
        "completeView": {
            "include": [
                "."
            ],
            "exclude": [
                ".dagger",
                "ast_parsers",
                "**/*_test.go"
            ]
        },
        "simplerView": {
            "include": [
                "cmd",
                "export",
                "utils",
                "pipeline",
                "caching",
                "graph",
                "parsers",
                "serve",
                "input"
            ],
            "exclude": [
                ".dagger",
                "ast_parsers",
                "**/*_test.go"
            ]
        },
        "smallerView": {
            "include": [
                "cmd",
                "export"
            ],
            "exclude": [
                "**/*_test.go"
            ]
        }
    }
}